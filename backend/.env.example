# --- Base de datos ---
DATABASE_URL=postgresql://usuario:clave@localhost:5432/sumaq_system

# --- Aplicación ---
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# --- Directorio local heredado (no se usa para nuevos avatares) ---
UPLOADS_DIRECTORY=uploads
AVATAR_MAX_BYTES=2097152
# Solo aplica al JPEG versionado; los datos SSR continúan sin esta caché.
AVATAR_CACHE_TTL_SECONDS=31536000
COMPANY_MEDIA_MAX_BYTES=3145728

# --- Almacenamiento privado de objetos (Cloudflare R2) ---
# Credenciales exclusivas del backend. Nunca enviarlas al frontend ni guardarlas en Git/BD.
STORAGE_PROVIDER=r2
STORAGE_ACCOUNT_ID=
STORAGE_BUCKET=sumaq-development-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Formato: https://<STORAGE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
# Cloudflare R2 requiere la región lógica auto.
STORAGE_REGION=auto
# Vigencia en segundos de cada URL temporal. Debe estar entre 1 y 3600.
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- JWT (generar secretos seguros en producción) ---
JWT_ACCESS_SECRET=reemplazar_por_un_secreto_seguro
JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_seguro
REFRESH_TOKEN_HASH_SECRET=reemplazar_por_un_tercer_secreto_hmac_independiente

# El JWT de acceso y su cookie duran esta cantidad de minutos.
JWT_ACCESS_TTL_MINUTES=15

# El JWT de refresco y su cookie duran esta cantidad de horas desde cada rotación.
JWT_REFRESH_TTL_HOURS=12

# Ventana deslizante sin actividad. Cada petición protegida o refresh válido la renueva.
SESSION_IDLE_TTL_MINUTES=120

# Duración máxima de una cadena de sesión aunque el usuario permanezca activo.
SESSION_ABSOLUTE_TTL_DAYS=30

# Evita interpretar dos refresh casi simultáneos como robo; fuera de esta gracia,
# reutilizar un refresh rotado revoca una sola vez su familia de sesión.
REFRESH_REUSE_GRACE_SECONDS=10

# Segunda capa de rate limit: solicitudes de refresh por sid firmado y ventana.
REFRESH_SESSION_RATE_LIMIT=10
REFRESH_SESSION_RATE_WINDOW_SECONDS=60

# Emisor (iss) y audiencia (aud) que se firman y se validan en cada token.
# Valores fijos de configuración, iguales en todas las instancias del backend.
JWT_ISSUER=sumaq-system
JWT_AUDIENCE=sumaq-api

# --- Seed inicial (obligatorias al ejecutar npm run db:seed) ---
OWNER_ORG_SLUG=admin
OWNER_ORG_NAME=SUMAQ SYSTEM
SUPERADMIN_EMAIL=admin@admin.sumaq
SUPERADMIN_USERNAME=JRUIZT
SUPERADMIN_PASSWORD=Reemplazar1!

# Dominio raíz del SaaS (dev: localhost; prod: sumaq.com). Sin protocolo ni puerto.
APP_BASE_DOMAIN=localhost

# --- Política de bloqueo de login (protección fuerza bruta) ---
# Intentos de contraseña fallidos consecutivos antes de bloquear la cuenta.
LOGIN_MAX_INTENTOS=19
# Minutos que dura el bloqueo tras alcanzar el límite (vencido, el contador reinicia a 0).
LOGIN_BLOQUEO_MINUTOS=60

# --- Límites de colecciones del perfil (máximo de registros activos por persona) ---
# Enteros > 0. Al alcanzarlos, el alta se rechaza con un mensaje entendible.
PROFILE_MAX_EMAILS=10
PROFILE_MAX_NATIONALITIES=10
PROFILE_MAX_INSURANCES=10
PROFILE_MAX_DOCUMENTS=10
PROFILE_MAX_HOBBIES=20
PROFILE_MAX_ACADEMIC_STUDIES=30
PROFILE_MAX_COMPLEMENTARY_STUDIES=30

# --- Notificaciones push (Firebase Cloud Messaging) — OPCIONAL ---
# Si faltan, el push queda deshabilitado (la app corre normal). Del service account JSON:
# FIREBASE_PROJECT_ID=tu-proyecto
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
# La clave privada va en UNA línea con \n escapados (tal cual el JSON):
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
