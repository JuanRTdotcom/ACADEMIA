generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["configuracion", "eventos", "nucleo", "personas", "seguridad", "system"]
}

model configuracion_organizacion {
  id_configuracion_organizacion String         @id @default(uuid()) @db.Uuid
  fid_organizaciones            String         @db.Uuid
  clave                         String
  valor                         Json
  estado                        Int            @default(1)
  created_at                    DateTime       @default(now()) @db.Timestamptz(3)
  created_by                    String?
  updated_at                    DateTime       @default(now()) @db.Timestamptz(3)
  updated_by                    String?
  organizacion                  organizaciones @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Cascade)

  @@unique([fid_organizaciones, clave])
  @@schema("configuracion")
}

model configuracion_usuario {
  id_configuracion_usuario String   @id @default(uuid()) @db.Uuid
  fid_usuarios             String   @db.Uuid
  clave                    String
  valor                    Json
  estado                   Int      @default(1)
  created_at               DateTime @default(now()) @db.Timestamptz(3)
  created_by               String?
  updated_at               DateTime @default(now()) @db.Timestamptz(3)
  updated_by               String?
  usuario                  usuarios @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@unique([fid_usuarios, clave])
  @@schema("seguridad")
}

model modulos {
  id_modulos                 String                   @id @default(uuid()) @db.Uuid
  codigo                     String                   @unique
  nombre                     String
  descripcion                String                   @db.VarChar(250)
  acceso_usuario_obligatorio Boolean                  @default(false)
  icono                      String?
  ruta                       String?
  fid_modulos_padre          String?                  @db.Uuid
  requiere_permiso           String?
  orden                      Int                      @default(0)
  estado                     Int                      @default(1)
  created_at                 DateTime                 @default(now()) @db.Timestamptz(3)
  created_by                 String?
  updated_at                 DateTime                 @default(now()) @db.Timestamptz(3)
  updated_by                 String?
  modulo_padre               modulos?                 @relation("arbol_modulos", fields: [fid_modulos_padre], references: [id_modulos])
  modulos_hijos              modulos[]                @relation("arbol_modulos")
  organizaciones_modulos     organizaciones_modulos[]
  planes_modulos             planes_modulos[]
  permisos                   permisos[]

  @@schema("configuracion")
}

model organizaciones_modulos {
  id_organizaciones_modulos String         @id @default(uuid()) @db.Uuid
  fid_organizaciones        String         @db.Uuid
  fid_modulos               String         @db.Uuid
  habilitado                Boolean        @default(true)
  estado                    Int            @default(1)
  created_at                DateTime       @default(now()) @db.Timestamptz(3)
  created_by                String?
  updated_at                DateTime       @default(now()) @db.Timestamptz(3)
  updated_by                String?
  modulo                    modulos        @relation(fields: [fid_modulos], references: [id_modulos], onDelete: Cascade)
  organizacion              organizaciones @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Cascade)

  @@unique([fid_organizaciones, fid_modulos])
  @@index([fid_organizaciones])
  @@schema("configuracion")
}

model planes {
  id_planes                String           @id @default(uuid()) @db.Uuid
  codigo                   String           @unique
  nombre                   String
  descripcion              String?
  almacenamiento_max_bytes BigInt?
  estado                   Int              @default(1)
  created_at               DateTime         @default(now()) @db.Timestamptz(3)
  created_by               String?
  updated_at               DateTime         @default(now()) @db.Timestamptz(3)
  updated_by               String?
  eliminado_en             DateTime?        @db.Timestamptz(3)
  organizaciones           organizaciones[]
  planes_modulos           planes_modulos[]
  renovaciones             renovaciones[]

  @@schema("configuracion")
}

model planes_modulos {
  id_planes_modulos String   @id @default(uuid()) @db.Uuid
  fid_planes        String   @db.Uuid
  fid_modulos       String   @db.Uuid
  estado            Int      @default(1)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_by        String?
  plan              planes   @relation(fields: [fid_planes], references: [id_planes], onDelete: Cascade)
  modulo            modulos  @relation(fields: [fid_modulos], references: [id_modulos], onDelete: Cascade)

  @@unique([fid_planes, fid_modulos])
  @@schema("configuracion")
}

model renovaciones {
  id_renovaciones    String         @id @default(uuid()) @db.Uuid
  fid_organizaciones String         @db.Uuid
  fid_planes         String         @db.Uuid
  fecha_inicio       DateTime       @db.Timestamptz(3)
  fecha_fin          DateTime       @db.Timestamptz(3)
  monto              Decimal?       @db.Decimal(10, 2)
  metodo_pago        String?        @db.VarChar(50)
  created_at         DateTime       @default(now()) @db.Timestamptz(3)
  created_by         String?
  organizacion       organizaciones @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Cascade)
  plan               planes         @relation(fields: [fid_planes], references: [id_planes])

  @@index([fid_organizaciones])
  @@schema("configuracion")
}

model parametros {
  id_parametros                           String                              @id @default(uuid()) @db.Uuid
  codigo_grupo                            String
  codigo                                  String
  etiqueta                                String
  orden                                   Int                                 @default(0)
  estado                                  Int                                 @default(1)
  created_at                              DateTime                            @default(now()) @db.Timestamptz(3)
  created_by                              String?
  updated_at                              DateTime                            @default(now()) @db.Timestamptz(3)
  updated_by                              String?
  color_hex                               String?                             @db.VarChar(7)
  traducciones                            parametros_traducciones[]
  perfiles_idioma                         perfil_organizacion[]               @relation("perfil_idioma")
  perfiles_moneda                         perfil_organizacion[]               @relation("perfil_moneda")
  perfiles_tipo_persona_fiscal            perfil_organizacion[]               @relation("perfil_tipo_persona_fiscal")
  perfiles_tipo_documento_fiscal          perfil_organizacion[]               @relation("perfil_tipo_documento_fiscal")
  perfiles_responsabilidad_fiscal         perfil_organizacion[]               @relation("perfil_responsabilidad_fiscal")
  organizaciones_especies                 organizaciones_especies_atendidas[]
  propietarios_tipo_documento             propietarios[]                      @relation("propietario_tipo_documento")
  propietarios_como_conocio               propietarios[]                      @relation("propietario_como_conocio")
  mascotas_genero                         mascotas[]                          @relation("mascota_genero")
  mascotas_unidad_peso                    mascotas[]                          @relation("mascota_unidad_peso")
  mascotas_talla                          mascotas[]                          @relation("mascota_talla")
  mascotas_estado_reproductivo            mascotas[]                          @relation("mascota_estado_reproductivo")
  mascotas_temperamento                   mascotas[]                          @relation("mascota_temperamento")
  mascotas_color                          mascotas[]                          @relation("mascota_color")
  atenciones_estado                       atenciones[]                        @relation("atencion_estado")
  registros_tipo_desparasitacion          registros_atencion[]                @relation("registro_tipo_desparasitacion")
  registros_motivo_salida_hospitalizacion registros_atencion[]                @relation("registro_motivo_salida_hospitalizacion")

  @@unique([codigo_grupo, codigo])
  @@schema("configuracion")
}

model parametros_traducciones {
  id_parametros_traducciones String     @id @default(uuid()) @db.Uuid
  fid_parametros             String     @db.Uuid
  codigo_idioma              String     @db.VarChar(10)
  etiqueta                   String     @db.VarChar(160)
  created_at                 DateTime   @default(now()) @db.Timestamptz(3)
  created_by                 String?
  updated_at                 DateTime   @default(now()) @db.Timestamptz(3)
  updated_by                 String?
  parametro                  parametros @relation(fields: [fid_parametros], references: [id_parametros], onDelete: Cascade)

  @@unique([fid_parametros, codigo_idioma])
  @@index([codigo_idioma])
  @@schema("configuracion")
}

model admin_level_0 {
  id_admin_level_0        String                    @id @default(uuid()) @db.Uuid
  codigo_iso2             String                    @unique @db.Char(2)
  nombre_es               String
  nombre_en               String
  etiqueta_admin_level_1  String                    @db.VarChar(50)
  etiqueta_admin_level_2  String?                   @db.VarChar(50)
  etiqueta_admin_level_3  String                    @db.VarChar(50)
  estado                  Int                       @default(1)
  created_at              DateTime                  @default(now()) @db.Timestamptz(3)
  created_by              String?
  updated_at              DateTime                  @default(now()) @db.Timestamptz(3)
  updated_by              String?
  admin_level_1           admin_level_1[]
  preferencias_usuario    preferencias_usuario[]
  personas_procedencia    personas[]                @relation("persona_pais_procedencia")
  personas_residencia     personas[]                @relation("persona_pais_residencia")
  personas_nacionalidades personas_nacionalidades[]
  perfiles_organizacion   perfil_organizacion[]     @relation("perfil_organizacion_pais")
  propietarios            propietarios[]
  rangos_geo_ip           rangos_geo_ip[]

  @@schema("configuracion")
}

model admin_level_1 {
  id_admin_level_1  String          @id @default(uuid()) @db.Uuid
  fid_admin_level_0 String          @db.Uuid
  codigo            String          @db.VarChar(20)
  nombre            String          @db.VarChar(100)
  estado            Int             @default(1)
  created_at        DateTime        @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime        @default(now()) @db.Timestamptz(3)
  updated_by        String?
  admin_level_0     admin_level_0   @relation(fields: [fid_admin_level_0], references: [id_admin_level_0], onDelete: Restrict)
  admin_level_2     admin_level_2[]
  admin_level_3     admin_level_3[]
  rangos_geo_ip     rangos_geo_ip[]

  @@unique([fid_admin_level_0, codigo])
  @@index([fid_admin_level_0])
  @@schema("configuracion")
}

model admin_level_2 {
  id_admin_level_2  String          @id @default(uuid()) @db.Uuid
  fid_admin_level_1 String          @db.Uuid
  codigo            String          @db.VarChar(20)
  nombre            String          @db.VarChar(100)
  estado            Int             @default(1)
  created_at        DateTime        @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime        @default(now()) @db.Timestamptz(3)
  updated_by        String?
  admin_level_1     admin_level_1   @relation(fields: [fid_admin_level_1], references: [id_admin_level_1], onDelete: Restrict)
  admin_level_3     admin_level_3[]

  @@unique([fid_admin_level_1, codigo])
  @@unique([id_admin_level_2, fid_admin_level_1])
  @@index([fid_admin_level_1])
  @@schema("configuracion")
}

model admin_level_3 {
  id_admin_level_3      String                @id @default(uuid()) @db.Uuid
  fid_admin_level_1     String                @db.Uuid
  fid_admin_level_2     String?               @db.Uuid
  codigo                String                @db.VarChar(20)
  nombre                String                @db.VarChar(120)
  estado                Int                   @default(1)
  created_at            DateTime              @default(now()) @db.Timestamptz(3)
  created_by            String?
  updated_at            DateTime              @default(now()) @db.Timestamptz(3)
  updated_by            String?
  admin_level_1         admin_level_1         @relation(fields: [fid_admin_level_1], references: [id_admin_level_1], onDelete: Restrict)
  admin_level_2         admin_level_2?        @relation(fields: [fid_admin_level_2, fid_admin_level_1], references: [id_admin_level_2, fid_admin_level_1], onDelete: Restrict)
  personas_procedencia  personas[]            @relation("persona_admin_level_3_procedencia")
  personas_residencia   personas[]            @relation("persona_admin_level_3_residencia")
  perfiles_organizacion perfil_organizacion[] @relation("perfil_organizacion_admin_level_3")
  propietarios          propietarios[]

  @@unique([fid_admin_level_1, codigo])
  @@index([fid_admin_level_1])
  @@index([fid_admin_level_2])
  @@schema("configuracion")
}

model preferencias_usuario {
  id_preferencias_usuario String          @id @default(uuid()) @db.Uuid
  fid_usuarios            String          @unique @db.Uuid
  fid_admin_level_0       String?         @db.Uuid
  fid_zonas_horarias      String?         @db.Uuid
  tema                    String?
  idioma                  String?
  menu_colapsado          Boolean         @default(false)
  formato_fecha           String?
  notificaciones          Json?
  estado                  Int             @default(1)
  created_at              DateTime        @default(now()) @db.Timestamptz(3)
  created_by              String?
  updated_at              DateTime        @default(now()) @db.Timestamptz(3)
  updated_by              String?
  usuario                 usuarios        @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)
  pais                    admin_level_0?  @relation(fields: [fid_admin_level_0], references: [id_admin_level_0])
  zona_horaria            zonas_horarias? @relation(fields: [fid_zonas_horarias], references: [id_zonas_horarias])

  @@index([fid_admin_level_0])
  @@index([fid_zonas_horarias])
  @@schema("seguridad")
}

model acciones_requeridas_maestro {
  id_acciones_requeridas_maestro String                @id @default(uuid()) @db.Uuid
  codigo                         String                @unique @db.VarChar(120)
  seccion                        String                @db.VarChar(60)
  nombre                         String                @db.VarChar(160)
  descripcion                    String?
  prioridad                      Int                   @default(1)
  icono                          String?               @db.VarChar(60)
  estado                         Int                   @default(1)
  created_at                     DateTime              @default(now()) @db.Timestamptz(3)
  created_by                     String?
  updated_at                     DateTime              @default(now()) @db.Timestamptz(3)
  updated_by                     String?
  acciones                       acciones_requeridas[]

  @@index([seccion, estado])
  @@schema("configuracion")
}

model zonas_horarias {
  id_zonas_horarias     String                 @id @default(uuid()) @db.Uuid
  nombre_iana           String                 @unique
  estado                Int                    @default(1)
  created_at            DateTime               @default(now()) @db.Timestamptz(3)
  created_by            String?
  updated_at            DateTime               @default(now()) @db.Timestamptz(3)
  updated_by            String?
  preferencias_usuario  preferencias_usuario[]
  perfiles_organizacion perfil_organizacion[]

  @@schema("system")
}

/// Rangos de IP pública → ubicación (país/región). Referencia la jerarquía
/// territorial. Se llena/actualiza fácil (p. ej. export de GeoLite2 a filas).
/// Las IP locales/privadas NO viven aquí: se detectan en la consulta.
model rangos_geo_ip {
  id_rangos_geo_ip  String              @id @default(uuid()) @db.Uuid
  ip_inicio         Unsupported("inet")
  ip_fin            Unsupported("inet")
  fid_admin_level_0 String?             @db.Uuid
  fid_admin_level_1 String?             @db.Uuid
  ciudad            String?             @db.VarChar(120)
  estado            Int                 @default(1)
  created_at        DateTime            @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime            @default(now()) @db.Timestamptz(3)
  updated_by        String?
  admin_level_0     admin_level_0?      @relation(fields: [fid_admin_level_0], references: [id_admin_level_0], onDelete: Restrict)
  admin_level_1     admin_level_1?      @relation(fields: [fid_admin_level_1], references: [id_admin_level_1], onDelete: Restrict)

  @@index([fid_admin_level_0])
  @@index([fid_admin_level_1])
  @@schema("system")
}

model eventos_maestro {
  id_eventos_maestro String    @id @default(uuid()) @db.Uuid
  codigo             String
  tipo_agregado      String
  nombre             String
  descripcion        String?
  version            Int       @default(1)
  visible_actividad  Boolean   @default(false)
  estado             Int       @default(1)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  created_by         String?
  updated_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_by         String?
  eventos            eventos[]

  @@unique([codigo, version])
  @@index([tipo_agregado])
  @@schema("eventos")
}

model eventos {
  id_eventos          String          @id @default(uuid()) @db.Uuid
  fid_organizaciones  String          @db.Uuid
  fid_usuarios        String?         @db.Uuid
  fid_eventos_maestro String          @db.Uuid
  id_agregado         String
  datos               Json
  metadatos           Json?
  ocurrido_en         DateTime        @default(now()) @db.Timestamptz(3)
  estado              Int             @default(1)
  created_at          DateTime        @default(now()) @db.Timestamptz(3)
  created_by          String?
  updated_at          DateTime        @default(now()) @db.Timestamptz(3)
  updated_by          String?
  evento_maestro      eventos_maestro @relation(fields: [fid_eventos_maestro], references: [id_eventos_maestro], onDelete: Restrict, onUpdate: Restrict)

  @@index([fid_organizaciones])
  @@index([fid_usuarios, ocurrido_en])
  @@index([fid_eventos_maestro, id_agregado])
  @@schema("eventos")
}

model organizaciones {
  id_organizaciones            String                              @id @default(uuid()) @db.Uuid
  slug                         String
  nombre                       String
  estado                       Int                                 @default(1)
  created_at                   DateTime                            @default(now()) @db.Timestamptz(3)
  created_by                   String?
  updated_at                   DateTime                            @default(now()) @db.Timestamptz(3)
  updated_by                   String?
  eliminado_en                 DateTime?                           @db.Timestamptz(3)
  eliminado_por                String?
  fid_planes                   String                              @default("40000000-0000-4000-8000-000000000003") @db.Uuid
  suscripcion_inicia_en        DateTime?                           @db.Timestamptz(3)
  suscripcion_expira_en        DateTime?                           @db.Timestamptz(3)
  duracion_cita_estimada       Int                                 @default(20)
  agenda_activa                Boolean                             @default(true)
  configuracion_organizacion   configuracion_organizacion[]
  organizaciones_modulos       organizaciones_modulos[]
  perfil                       perfil_organizacion?
  imagenes_login               imagenes_login_organizacion[]
  horarios_atencion            horarios_atencion_organizacion[]
  personas                     personas[]
  usuarios                     usuarios[]
  acciones_requeridas          acciones_requeridas[]
  renovaciones                 renovaciones[]
  servicios_veterinaria        servicios_veterinaria[]
  propietarios                 propietarios[]
  mascotas                     mascotas[]
  atenciones                   atenciones[]
  registros_atencion           registros_atencion[]
  motivos_consulta             motivos_consulta[]
  vacunas                      vacunas[]
  tipos_hospitalizacion        tipos_hospitalizacion[]
  procedimientos_veterinarios  procedimientos_veterinarios[]
  pruebas_laboratorio          pruebas_laboratorio[]
  pruebas_registro_laboratorio pruebas_registro_laboratorio[]
  adjuntos_registro_atencion   adjuntos_registro_atencion[]
  archivos_organizacion        archivos_organizacion[]
  especies_atendidas           organizaciones_especies_atendidas[]
  plan                         planes                              @relation(fields: [fid_planes], references: [id_planes])

  @@index([eliminado_en, estado, nombre])
  @@schema("nucleo")
}

model archivos_organizacion {
  id_archivos_organizacion String         @id @default(uuid()) @db.Uuid
  fid_organizaciones       String         @db.Uuid
  clave_objeto             String         @unique @db.VarChar(1024)
  tipo_mime                String         @db.VarChar(120)
  bytes                    BigInt
  estado                   Int            @default(2)
  created_at               DateTime       @default(now()) @db.Timestamptz(3)
  created_by               String?
  updated_at               DateTime       @default(now()) @db.Timestamptz(3)
  updated_by               String?
  eliminado_en             DateTime?      @db.Timestamptz(3)
  eliminado_por            String?
  organizacion             organizaciones @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Restrict)

  @@index([fid_organizaciones, estado])
  @@schema("nucleo")
}

model perfil_organizacion {
  id_perfil_organizacion                String         @id @default(uuid()) @db.Uuid
  fid_organizaciones                    String         @unique @db.Uuid
  razon_social                          String?
  ruc_nif                               String?
  direccion                             String?
  sin_sede_fisica                       Boolean        @default(false)
  referencia                            String?        @db.VarChar(200)
  fid_admin_level_0                     String?        @db.Uuid
  fid_admin_level_3                     String?        @db.Uuid
  telefono                              String?
  telefono_secundario                   String?        @db.VarChar(30)
  correo_contacto                       String?
  correo_contacto_secundario            String?        @db.VarChar(120)
  sitio_web                             String?
  facebook_url                          String?        @db.VarChar(200)
  instagram_url                         String?        @db.VarChar(200)
  tiktok_url                            String?        @db.VarChar(200)
  youtube_url                           String?        @db.VarChar(200)
  linkedin_url                          String?        @db.VarChar(200)
  x_url                                 String?        @db.VarChar(200)
  logo_url                              String?
  escudo_url                            String?
  escudo_oscuro_url                     String?
  escudo_misma_imagen                   Boolean        @default(true)
  login_escudo_url                      String?
  login_escudo_oscuro_url               String?
  login_escudo_misma_imagen             Boolean        @default(true)
  imagotipo_url                         String?
  imagotipo_oscuro_url                  String?
  imagotipo_misma_imagen                Boolean        @default(true)
  color_primario                        String?
  ui_cabecera_claro                     String?        @db.VarChar(7)
  ui_cabecera_oscuro                    String?        @db.VarChar(7)
  ui_esquinero_claro                    String?        @db.VarChar(7)
  ui_esquinero_oscuro                   String?        @db.VarChar(7)
  ui_menu_claro                         String?        @db.VarChar(7)
  ui_menu_oscuro                        String?        @db.VarChar(7)
  ui_mostrar_escudo_menu                Boolean        @default(false)
  ui_mostrar_nombre_empresa_menu        Boolean        @default(true)
  ui_ocultar_esquinero_expandido        Boolean        @default(false)
  ui_esquinero_fondo_activo             Boolean        @default(false)
  ui_cabecera_ocultar_borde             Boolean        @default(false)
  ui_menu_ocultar_borde                 Boolean        @default(false)
  ui_tamano_escudo_menu                 Int            @default(100) @db.SmallInt
  login_mostrar_panel                   Boolean        @default(true)
  login_usar_filtro_color               Boolean        @default(true)
  login_mostrar_etiqueta                Boolean        @default(true)
  login_mostrar_destacados              Boolean        @default(true)
  login_mostrar_comunidad               Boolean        @default(true)
  login_mostrar_recuperar               Boolean        @default(false)
  login_mostrar_recordar                Boolean        @default(false)
  login_mostrar_google                  Boolean        @default(false)
