model credenciales {
  id_credenciales        String          @id @default(uuid()) @db.Uuid
  fid_usuarios           String          @db.Uuid
  fid_dispositivos       String?         @db.Uuid
  tipo                   tipo_credencial
  hash_contrasenia       String?
  llave_publica          String?
  id_credencial_webauthn String?
  contador               Int?
  estado                 Int             @default(1)
  created_at             DateTime        @default(now()) @db.Timestamptz(3)
  created_by             String?
  updated_at             DateTime        @default(now()) @db.Timestamptz(3)
  updated_by             String?
  dispositivo            dispositivos?   @relation(fields: [fid_dispositivos], references: [id_dispositivos], onDelete: Cascade)
  usuario                usuarios        @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@index([fid_usuarios])
  @@index([fid_usuarios, tipo, estado])
  @@schema("seguridad")
}

model dispositivos {
  id_dispositivos         String                 @id @default(uuid()) @db.Uuid
  fid_usuarios            String                 @db.Uuid
  uid_dispositivo         String
  firebase_id_instalacion String?
  plataforma              plataforma_dispositivo
  tipo_dispositivo        tipo_dispositivo       @default(desconocido)
  modelo                  String?
  version_so              String?
  version_app             String?
  firebase_token_fcm      String?
  confiable               Boolean                @default(false)
  ultimo_acceso_en        DateTime?              @db.Timestamptz(3)
  estado                  Int                    @default(1)
  created_at              DateTime               @default(now()) @db.Timestamptz(3)
  created_by              String?
  updated_at              DateTime               @default(now()) @db.Timestamptz(3)
  updated_by              String?
  credenciales            credenciales[]
  usuario                 usuarios               @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)
  sesiones                sesiones[]

  @@unique([fid_usuarios, uid_dispositivo])
  @@index([fid_usuarios])
  @@schema("seguridad")
}

model historial_contrasenias {
  id_historial_contrasenias String   @id @default(uuid()) @db.Uuid
  fid_usuarios              String   @db.Uuid
  hash_contrasenia          String
  estado                    Int      @default(1)
  created_at                DateTime @default(now()) @db.Timestamptz(3)
  created_by                String?
  updated_at                DateTime @default(now()) @db.Timestamptz(3)
  updated_by                String?
  usuario                   usuarios @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@index([fid_usuarios])
  @@schema("seguridad")
}

model permisos {
  id_permisos       String              @id @default(uuid()) @db.Uuid
  fid_modulos       String              @db.Uuid
  codigo            String              @unique
  accion            String              @db.VarChar(40)
  descripcion       String?
  estado            Int                 @default(1)
  created_at        DateTime            @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime            @default(now()) @db.Timestamptz(3)
  updated_by        String?
  modulo            modulos             @relation(fields: [fid_modulos], references: [id_modulos], onDelete: Restrict)
  roles_permisos    roles_permisos[]
  usuarios_permisos usuarios_permisos[]

  @@unique([fid_modulos, accion])
  @@index([fid_modulos, estado])
  @@schema("seguridad")
}

model roles {
  id_roles              String           @id @default(uuid()) @db.Uuid
  codigo                String           @db.VarChar(40)
  nombre                String           @db.VarChar(80)
  icono                 String           @default("shield-check") @db.VarChar(40)
  descripcion           String           @db.VarChar(250)
  asignable_por_empresa Boolean          @default(true)
  estado                Int              @default(1)
  created_at            DateTime         @default(now()) @db.Timestamptz(3)
  created_by            String?
  updated_at            DateTime         @default(now()) @db.Timestamptz(3)
  updated_by            String?
  eliminado_en          DateTime?        @db.Timestamptz(3)
  eliminado_por         String?
  roles_permisos        roles_permisos[]
  usuarios_roles        usuarios_roles[]

  @@index([eliminado_en, created_at])
  @@schema("seguridad")
}

model roles_permisos {
  id_roles_permisos String   @id @default(uuid()) @db.Uuid
  fid_roles         String   @db.Uuid
  fid_permisos      String   @db.Uuid
  estado            Int      @default(1)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_by        String?
  permiso           permisos @relation(fields: [fid_permisos], references: [id_permisos], onDelete: Cascade)
  rol               roles    @relation(fields: [fid_roles], references: [id_roles], onDelete: Cascade)

  @@unique([fid_roles, fid_permisos])
  @@schema("seguridad")
}

model sesiones {
  id_sesiones           String       @id @default(uuid()) @db.Uuid
  fid_dispositivos      String       @db.Uuid
  hash_token_refresco   String
  generacion            Int          @default(0)
  agente_usuario        String?
  ip                    String?
  iniciada_en           DateTime     @default(now()) @db.Timestamptz(3)
  ultimo_uso_en         DateTime     @default(now()) @db.Timestamptz(3)
  expira_inactividad_en DateTime     @db.Timestamptz(3)
  expira_absoluta_en    DateTime     @db.Timestamptz(3)
  expira_en             DateTime     @db.Timestamptz(3)
  rotada_en             DateTime?    @db.Timestamptz(3)
  reuso_detectado_en    DateTime?    @db.Timestamptz(3)
  revocada_en           DateTime?    @db.Timestamptz(3)
  estado                Int          @default(1)
  created_at            DateTime     @default(now()) @db.Timestamptz(3)
  created_by            String?
  updated_at            DateTime     @default(now()) @db.Timestamptz(3)
  updated_by            String?
  dispositivo           dispositivos @relation(fields: [fid_dispositivos], references: [id_dispositivos], onDelete: Cascade)

  @@index([fid_dispositivos])
  @@index([expira_inactividad_en])
  @@schema("seguridad")
}

model tokens_verificacion {
  id_tokens_verificacion String     @id @default(uuid()) @db.Uuid
  fid_usuarios           String     @db.Uuid
  tipo                   tipo_token
  hash_token             String
  expira_en              DateTime   @db.Timestamptz(3)
  usado_en               DateTime?  @db.Timestamptz(3)
  estado                 Int        @default(1)
  created_at             DateTime   @default(now()) @db.Timestamptz(3)
  created_by             String?
  updated_at             DateTime   @default(now()) @db.Timestamptz(3)
  updated_by             String?
  usuario                usuarios   @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@index([fid_usuarios])
  @@schema("seguridad")
}

model usuario_mfa {
  id_usuario_mfa String    @id @default(uuid()) @db.Uuid
  fid_usuarios   String    @db.Uuid
  tipo           tipo_mfa
  secreto        String?
  telefono       String?
  habilitado     Boolean   @default(false)
  confirmado_en  DateTime? @db.Timestamptz(3)
  estado         Int       @default(1)
  created_at     DateTime  @default(now()) @db.Timestamptz(3)
  created_by     String?
  updated_at     DateTime  @default(now()) @db.Timestamptz(3)
  updated_by     String?
  usuario        usuarios  @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@unique([fid_usuarios, tipo])
  @@schema("seguridad")
}

model usuarios {
  id_usuarios                     String                         @id @default(uuid()) @db.Uuid
  fid_personas                    String                         @db.Uuid
  fid_organizaciones              String                         @db.Uuid
  usuario                         String                         @db.VarChar(20)
  estado_cuenta                   estado_usuario                 @default(activo)
  intentos_fallidos               Int                            @default(0)
  bloqueado_hasta                 DateTime?                      @db.Timestamptz(3)
  estado                          Int                            @default(1)
  created_at                      DateTime                       @default(now()) @db.Timestamptz(3)
  created_by                      String?
  updated_at                      DateTime                       @default(now()) @db.Timestamptz(3)
  updated_by                      String?
  eliminado_en                    DateTime?                      @db.Timestamptz(3)
  eliminado_por                   String?
  configuracion_usuario           configuracion_usuario[]
  preferencias_usuario            preferencias_usuario?
  codigos_recuperacion_mfa        codigos_recuperacion_mfa[]
  credenciales                    credenciales[]
  dispositivos                    dispositivos[]
  historial_contrasenias          historial_contrasenias[]
  tokens_verificacion             tokens_verificacion[]
  usuario_mfa                     usuario_mfa[]
  organizacion                    organizaciones                 @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Cascade)
  persona                         personas                       @relation(fields: [fid_personas], references: [id_personas], onDelete: Cascade)
  usuarios_roles                  usuarios_roles[]
  usuarios_permisos               usuarios_permisos[]
  acciones_requeridas             acciones_requeridas[]
  atenciones_responsable          atenciones[]                   @relation("atencion_responsable")
  pruebas_laboratorio_profesional pruebas_registro_laboratorio[] @relation("prueba_laboratorio_profesional")

  // PostgreSQL conserva unicidad solo para filas no eliminadas (índice parcial).
  // Prisma no representa índices parciales, por eso aquí queda como índice normal.
  @@unique([id_usuarios, fid_organizaciones])
  @@index([fid_organizaciones, usuario])
  @@index([fid_organizaciones, eliminado_en, created_at])
  @@schema("seguridad")
}

model usuarios_permisos {
  id_usuarios_permisos String                 @id @default(uuid()) @db.Uuid
  fid_usuarios         String                 @db.Uuid
  fid_permisos         String                 @db.Uuid
  efecto               efecto_permiso_usuario @default(permitir)
  estado               Int                    @default(1)
  created_at           DateTime               @default(now()) @db.Timestamptz(3)
  created_by           String?
  updated_at           DateTime               @default(now()) @db.Timestamptz(3)
  updated_by           String?
  permiso              permisos               @relation(fields: [fid_permisos], references: [id_permisos], onDelete: Cascade)
  usuario              usuarios               @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@unique([fid_usuarios, fid_permisos])
  @@index([fid_usuarios, estado])
  @@schema("seguridad")
}

model acciones_requeridas {
  id_acciones_requeridas          String                      @id @default(uuid()) @db.Uuid
  fid_organizaciones              String                      @db.Uuid
  fid_usuarios                    String                      @db.Uuid
  fid_acciones_requeridas_maestro String                      @db.Uuid
  clave_recurso                   String                      @db.VarChar(120)
  metadatos                       Json?
  resuelta_en                     DateTime?                   @db.Timestamptz(3)
  estado                          Int                         @default(1)
  created_at                      DateTime                    @default(now()) @db.Timestamptz(3)
  created_by                      String?
  updated_at                      DateTime                    @default(now()) @db.Timestamptz(3)
  updated_by                      String?
  organizacion                    organizaciones              @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Cascade)
  usuario                         usuarios                    @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)
  accion_maestro                  acciones_requeridas_maestro @relation(fields: [fid_acciones_requeridas_maestro], references: [id_acciones_requeridas_maestro], onDelete: Restrict)

  @@unique([fid_usuarios, fid_acciones_requeridas_maestro, clave_recurso])
  @@index([fid_organizaciones, fid_usuarios, estado])
  @@index([fid_acciones_requeridas_maestro, estado])
  @@schema("seguridad")
}

model usuarios_roles {
  id_usuarios_roles String   @id @default(uuid()) @db.Uuid
  fid_usuarios      String   @db.Uuid
  fid_roles         String   @db.Uuid
  estado            Int      @default(1)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_by        String?
  rol               roles    @relation(fields: [fid_roles], references: [id_roles], onDelete: Cascade)
  usuario           usuarios @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@unique([fid_usuarios, fid_roles])
  @@schema("seguridad")
}

enum estado_usuario {
  activo
  invitado
  suspendido

  @@schema("seguridad")
}

enum efecto_permiso_usuario {
  permitir
  denegar

  @@schema("seguridad")
}

enum plataforma_dispositivo {
  ios
  android
  web
  desconocido

  @@schema("seguridad")
}

enum tipo_dispositivo {
  escritorio
  movil
  tableta
  desconocido

  @@schema("seguridad")
}

enum tipo_credencial {
  contrasenia
  passkey

  @@schema("seguridad")
}

enum tipo_mfa {
  totp
  sms
  correo

  @@schema("seguridad")
}

enum tipo_uso_correo {
  principal
  mensajes
  respaldo

  @@schema("personas")
}

enum tipo_token {
  verificacion_correo
  reset_contrasenia
  enlace_magico
  invitacion
  dispositivo_nuevo

  @@schema("seguridad")
}
