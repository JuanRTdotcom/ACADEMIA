  fid_usuarios         String                 @db.Uuid
  fid_permisos         String                 @db.Uuid
  efecto               efecto_permiso_usuario @default(permitir)
  estado               Int                    @default(1)
  created_at           DateTime               @default(now()) @db.Timestamptz(3)
  created_by           String?
  updated_at           DateTime               @default(now()) @db.Timestamptz(3)
  updated_by           String?
  permiso              permisos               @relation(fields: [fid_permisos], references: [id_permisos], onDelete: Cascade)
  usuario              usuarios               @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@unique([fid_usuarios, fid_permisos])
  @@index([fid_usuarios, estado])
  @@schema("seguridad")
}

model acciones_requeridas {
  id_acciones_requeridas          String                      @id @default(uuid()) @db.Uuid
  fid_organizaciones              String                      @db.Uuid
  fid_usuarios                    String                      @db.Uuid
  fid_acciones_requeridas_maestro String                      @db.Uuid
  clave_recurso                   String                      @db.VarChar(120)
  metadatos                       Json?
  resuelta_en                     DateTime?                   @db.Timestamptz(3)
  estado                          Int                         @default(1)
  created_at                      DateTime                    @default(now()) @db.Timestamptz(3)
  created_by                      String?
  updated_at                      DateTime                    @default(now()) @db.Timestamptz(3)
  updated_by                      String?
  organizacion                    organizaciones              @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Cascade)
  usuario                         usuarios                    @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)
  accion_maestro                  acciones_requeridas_maestro @relation(fields: [fid_acciones_requeridas_maestro], references: [id_acciones_requeridas_maestro], onDelete: Restrict)

  @@unique([fid_usuarios, fid_acciones_requeridas_maestro, clave_recurso])
  @@index([fid_organizaciones, fid_usuarios, estado])
  @@index([fid_acciones_requeridas_maestro, estado])
  @@schema("seguridad")
}

model usuarios_roles {
  id_usuarios_roles String   @id @default(uuid()) @db.Uuid
  fid_usuarios      String   @db.Uuid
  fid_roles         String   @db.Uuid
  estado            Int      @default(1)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  created_by        String?
  updated_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_by        String?
  rol               roles    @relation(fields: [fid_roles], references: [id_roles], onDelete: Cascade)
  usuario           usuarios @relation(fields: [fid_usuarios], references: [id_usuarios], onDelete: Cascade)

  @@unique([fid_usuarios, fid_roles])
  @@schema("seguridad")
}

