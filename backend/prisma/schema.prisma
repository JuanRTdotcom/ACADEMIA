  eliminado_por                   String?
  configuracion_usuario           configuracion_usuario[]
  preferencias_usuario            preferencias_usuario?
  codigos_recuperacion_mfa        codigos_recuperacion_mfa[]
  credenciales                    credenciales[]
  dispositivos                    dispositivos[]
  historial_contrasenias          historial_contrasenias[]
  tokens_verificacion             tokens_verificacion[]
  usuario_mfa                     usuario_mfa[]
  organizacion                    organizaciones                      @relation(fields: [fid_organizaciones], references: [id_organizaciones], onDelete: Cascade)
  persona                         personas                            @relation(fields: [fid_personas], references: [id_personas], onDelete: Cascade)
  usuarios_roles                  usuarios_roles[]
  usuarios_permisos               usuarios_permisos[]
  acciones_requeridas             acciones_requeridas[]
  atenciones_responsable          atenciones[]                        @relation("atencion_responsable")
  pruebas_laboratorio_profesional pruebas_registro_laboratorio[]      @relation("prueba_laboratorio_profesional")
  servicios_peluqueria_encargado  servicios_registro_peluqueria_spa[] @relation("servicio_peluqueria_encargado")
  registros_remitidos             registros_atencion[]                @relation("registro_usuario_remitente")
  citas_responsable               citas[]                             @relation("cita_responsable")
  ventas_responsable              ventas[]                            @relation("venta_responsable")

  // PostgreSQL conserva unicidad solo para filas no eliminadas (índice parcial).
  // Prisma no representa índices parciales, por eso aquí queda como índice normal.
  @@unique([id_usuarios, fid_organizaciones])
  @@index([fid_organizaciones, usuario])
  @@index([fid_organizaciones, eliminado_en, created_at])
  @@index([fid_organizaciones, eliminado_en, created_at(sort: Desc), id_usuarios(sort: Desc)], map: "usuarios_empresa_cursor_idx")
  @@schema("seguridad")
}

