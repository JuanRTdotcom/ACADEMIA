# Dominio raíz del SaaS (dev: localhost; prod: sumaq.com). Sin protocolo ni puerto.
APP_BASE_DOMAIN=localhost

# --- Política de bloqueo de login (protección fuerza bruta) ---
# Intentos de contraseña fallidos consecutivos antes de bloquear la cuenta.
LOGIN_MAX_INTENTOS=19
# Minutos que dura el bloqueo tras alcanzar el límite (vencido, el contador reinicia a 0).
LOGIN_BLOQUEO_MINUTOS=60

# --- Límites de colecciones del perfil (máximo de registros activos por persona) ---
# Enteros > 0. Al alcanzarlos, el alta se rechaza con un mensaje entendible.
PROFILE_MAX_EMAILS=10
PROFILE_MAX_NATIONALITIES=10
PROFILE_MAX_INSURANCES=10
PROFILE_MAX_DOCUMENTS=10
PROFILE_MAX_HOBBIES=30
PROFILE_MAX_ACADEMIC_STUDIES=30
PROFILE_MAX_COMPLEMENTARY_STUDIES=30

