# Local dev config. Not committed (see .gitignore). Copy of .env.example.

# --- URLs (two distinct origins) ---
# Backend (Nest) base URL, where this front sends API requests. No trailing slash.
API_URL=http://localhost:3000
# This frontend's own canonical public URL. The live request host is always
# available at runtime via event.url; use this for fixed/canonical needs
# (absolute redirects, emails, CORS reference). No trailing slash.
APP_URL=http://localhost:5173

# --- Auth cookie lifetimes (in seconds) ---
# 900 = 15 minutes
ACCESS_TOKEN_TTL=900
# 43200 = 12 hours
REFRESH_TOKEN_TTL=43200

# Name of the refresh-token cookie as issued by the backend.
REFRESH_COOKIE_NAME=refresh_token

# Debe coincidir con AVATAR_MAX_BYTES del backend.
AVATAR_MAX_BYTES=3145728

# --- Firebase (config pública del cliente para push web) ---
PUBLIC_APP_VERSION=0.0.1
PUBLIC_FIREBASE_API_KEY=AIzaSyBsC3-HlnqSmgrXXeI-Cuo8S5E29GsiTdI
PUBLIC_FIREBASE_AUTH_DOMAIN=sumaq-system-notify.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=sumaq-system-notify
PUBLIC_FIREBASE_STORAGE_BUCKET=sumaq-system-notify.firebasestorage.app
