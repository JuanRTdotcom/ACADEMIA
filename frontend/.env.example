# --- URLs (two distinct origins) ---
# Backend (Nest) base URL, where this front sends API requests. No trailing slash.
API_URL=http://localhost:3000
# This frontend's own canonical public URL. The live request host is always
# available at runtime via event.url; use this for fixed/canonical needs
# (absolute redirects, emails, CORS reference). No trailing slash.
APP_URL=http://localhost:5173

# --- Auth cookie lifetimes (in seconds) ---
# 900 = 15 minutes
ACCESS_TOKEN_TTL=900
# 43200 = 12 hours
REFRESH_TOKEN_TTL=43200

# Name of the refresh-token cookie as issued by the backend.
REFRESH_COOKIE_NAME=refresh_token

# Entrada máxima compartida por avatar y foto de mascota; debe coincidir con backend.
AVATAR_MAX_BYTES=3145728

# --- Tenant no registrado ---
# Adónde redirigir cuando el subdominio no corresponde a una organización activa.
# Vacío/ausente = se muestra la página 404 interna. Más adelante puede apuntar a una
# landing pública (ej. https://sumaq.com). URL absoluta, sin barra final.
TENANT_NOT_FOUND_URL=

# --- Firebase (config pública del cliente para push web) ---
PUBLIC_APP_VERSION=0.0.1
# Del "web app config" de Firebase Console + VAPID key (Cloud Messaging → Web Push certs).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_VAPID_KEY=
