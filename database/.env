# Postgres — credenciales de desarrollo local
POSTGRES_USER=academia
POSTGRES_PASSWORD=academia_dev
POSTGRES_DB=sumaq_system
POSTGRES_PORT=5432

# Cadena de conexion para Prisma / backend.
# Se usa desde el backend: DATABASE_URL apunta a este contenedor.
DATABASE_URL=postgresql://academia:academia_dev@localhost:5432/sumaq_system?schema=public

# pgAdmin — visor web (http://localhost:5050)
PGADMIN_EMAIL=admin@academia.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
